# Modelo de site adicional. Não substituir o Caddyfile compartilhado inteiro.
# Estado validado pelo operador: Caddy 2.11.7, HTTPS público sem senha.
# Não substituir os demais hosts nem abrir a porta 8766 para a internet.
poc-srag.estacaolab.com.br {
    header X-Robots-Tag "noindex, nofollow"

    reverse_proxy indicium-srag-hml-api:8000 {
        header_up -Authorization
    }
}
