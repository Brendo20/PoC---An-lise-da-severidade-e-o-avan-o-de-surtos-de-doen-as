FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY sql/ ./sql/
RUN python -m pip install --no-cache-dir -e ".[api]"
RUN mkdir -p /var/lib/srag/reports && chown -R 10001:10001 /var/lib/srag && chmod 700 /var/lib/srag/reports
COPY frontend/index.html frontend/app.js frontend/styles.css ./frontend/
COPY frontend/assets/ ./frontend/assets/
COPY frontend/vendor/ ./frontend/vendor/

USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "srag.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "8", "--backlog", "16", "--timeout-keep-alive", "5", "--no-server-header", "--no-proxy-headers"]
