FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY sql/ ./sql/
RUN python -m pip install --no-cache-dir -e ".[postgres]"

USER 10001:10001
ENTRYPOINT ["python", "-m"]
